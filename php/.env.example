# Global Payments eCOM (GPeCOM) Configuration
# Copy this file to .env and update with your credentials

# GPeCOM Credentials
GPECOM_MERCHANT_ID=your_merchant_id
GPECOM_SHARED_SECRET=your_shared_secret
GPECOM_REFUND_PASSWORD=your_refund_password_sha1_hash

# Account/Sub-account for 3DS2 (must have MPI enabled)
GPECOM_ACCOUNT=internet

# Environment
GPECOM_SANDBOX=true

# Webhook URLs
# For production: use your actual HTTPS public URLs
# For local development: use ngrok or the GP developer test URLs below
METHOD_NOTIFICATION_URL=https://developer.globalpayments.com/3ds2/method-notification
CHALLENGE_NOTIFICATION_URL=https://developer.globalpayments.com/3ds2/challenge-notification

# Debug Mode (enables request/response logging)
DEBUG_MODE=true
